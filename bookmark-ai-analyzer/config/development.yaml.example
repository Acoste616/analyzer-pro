# Development Configuration
environment: development
debug: true

# LLM Providers
grok:
  api_key: ${GROK_API_KEY}  # Set via environment variable
  model: grok-beta
  max_tokens: 4096
  temperature: 0.7
  timeout: 30
  max_retries: 3
  rate_limit: 60

claude:
  api_key: ${CLAUDE_API_KEY}  # Set via environment variable
  model: claude-3-opus-20240229
  max_tokens: 4096
  temperature: 0.7
  timeout: 30
  max_retries: 3
  rate_limit: 60

gemini:
  api_key: ${GEMINI_API_KEY}  # Set via environment variable
  model: gemini-pro
  max_tokens: 4096
  temperature: 0.7
  timeout: 30
  max_retries: 3
  rate_limit: 60

# Default LLM provider
default_llm: claude

# Processing Configuration
processing:
  batch_size: 50
  max_workers: 2
  checkpoint_interval: 25
  memory_limit_mb: 1024
  enable_caching: true
  cache_ttl: 3600

# Export Configuration
export:
  formats:
    - json
    - anki
    - notion
    - obsidian
  output_dir: data/processed
  compress: true
  include_metadata: true

# Logging Configuration
logging:
  level: DEBUG
  format: "{time:YYYY-MM-DD HH:mm:ss} | {level} | {name}:{function}:{line} - {message}"
  rotation: 10 MB
  retention: 7 days
  backtrace: true
  diagnose: true

# Database
database_url: sqlite:///data/bookmarks_dev.db

# Redis (optional)
# redis_url: redis://localhost:6379/0