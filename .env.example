# Bookmark AI Analyzer Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# LLM API KEYS
# =============================================================================

# Anthropic Claude API
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Grok (X/Twitter) API
# Get your key from: https://platform.openai.com/ (when available)
GROK_API_KEY=your_grok_api_key_here

# OpenAI API (for future integration)
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# PROCESSING CONFIGURATION
# =============================================================================

# Maximum number of concurrent workers for processing
MAX_WORKERS=4

# Batch size for processing bookmarks
BATCH_SIZE=10

# Checkpoint interval (save progress every N items)
CHECKPOINT_INTERVAL=50

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Cache directory path
CACHE_DIR=data/cache

# Default cache TTL in seconds (3600 = 1 hour)
CACHE_TTL=3600

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL configuration (for production)
DATABASE_URL=postgresql://bookmark_user:your_password@localhost:5432/bookmark_analyzer
POSTGRES_PASSWORD=your_secure_password_here

# SQLite configuration (for development)
SQLITE_PATH=data/bookmark_analyzer.db

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis URL for caching and task queues
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# FILE PATHS
# =============================================================================

# Directory paths
DATA_DIR=data
LOG_DIR=logs
CHECKPOINT_DIR=data/checkpoints
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
KNOWLEDGE_BASE_DIR=data/knowledge_base

# =============================================================================
# WEB SCRAPING CONFIGURATION
# =============================================================================

# Request timeout in seconds
REQUEST_TIMEOUT=30

# User agent for web scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36

# Rate limiting for external APIs
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_TOKENS_PER_MINUTE=200000

# =============================================================================
# ANALYSIS CONFIGURATION
# =============================================================================

# Default LLM provider (grok, claude, gemini)
DEFAULT_LLM_PROVIDER=claude

# Enable/disable analysis features
ENABLE_CONTENT_ANALYSIS=true
ENABLE_CATEGORIZATION=true
ENABLE_TAGGING=true

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Secret key for encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here

# JWT secret for authentication (if implementing web interface)
JWT_SECRET=your_jwt_secret_here

# =============================================================================
# MONITORING AND METRICS
# =============================================================================

# Enable Prometheus metrics
ENABLE_METRICS=false

# Metrics port
METRICS_PORT=9090

# Health check interval in seconds
HEALTH_CHECK_INTERVAL=30

# =============================================================================
# TWITTER/X API CONFIGURATION
# =============================================================================

# Twitter API v2 configuration (if available)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# =============================================================================
# YOUTUBE API CONFIGURATION
# =============================================================================

# YouTube Data API v3 key
# Get from: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Memory limit for cache (number of items)
CACHE_MEMORY_LIMIT=1000

# Enable debug logging for specific modules
DEBUG_MODULES=src.analyzers,src.extractors

# Custom prompt templates directory
PROMPT_TEMPLATES_DIR=config/prompts

# Export formats (comma-separated: json,csv,markdown)
EXPORT_FORMATS=json,csv

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable test mode
TEST_MODE=false

# Sample data size for testing
SAMPLE_SIZE=10

# Enable development features
DEV_FEATURES=true

# Auto-reload on file changes
AUTO_RELOAD=true